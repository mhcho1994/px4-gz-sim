# ================================
# Autopilot / Simulation Sources
# ================================

# ArduPilot source (large repo, usually managed as submodule or cloned separately)
/ap/*
!/ap/ardupilot
!/ap/px4

# ROS2 workspace (build/install/log can be large and environment-specific)
/ros2

# Gazebo source or workspace (can be rebuilt locally, submodules or setup scripts are preferred)
/gz/*
!/gz/ardupilot_gazebo
!/gz/SITL_Models
!/gz/PX4_gazebo_models

# QGroundControl binaries/tools (platform-dependent, not needed in repo)
/tools/QGC

# ================================
# Python Environment
# ================================

# Python virtual environment (machine-specific)
/.venv

# Python cache files
__pycache__/

# ================================
# Simulation Logs / Data
# ================================

# All generated logs (PX4, ArduPilot, Gazebo, etc.)
/data/*

# Keep documentation and ignore rules inside data directory
!/data/README.md
!.gitignore

# ================================
# MAVLink / Runtime Artifacts
# ================================

# EEPROM state file generated by SITL
eeprom.bin

# MAVLink telemetry logs
mav.tlog
mav.tlog.*

# ================================
# Docker Artifacts
# ================================
/.docker_home

# ================================
# Notes
# ================================
# - Large dependencies (PX4, ArduPilot, ROS2, Gazebo) should be managed via submodules or setup scripts
# - Logs are intentionally ignored to keep repo lightweight and reproducible