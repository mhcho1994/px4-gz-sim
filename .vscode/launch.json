{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: ArduPilot+Gazebo launcher",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "${workspaceFolder}/tools/launcher/run_arducopter_gz_sitl.py",
      "args": [
        "--run-root", "./data",
        "--force",
        "--startup-delay", "2",
        "--max-run-s", "300"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
