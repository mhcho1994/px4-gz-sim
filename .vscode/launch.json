{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Scenario Generator",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/scenario/scenario_generator.py",
      "args": [
        "three_d_n_pts",
        "--outdir", "${workspaceFolder}/data/sitl_logs",
        "--runs", "1000",
        "--start-run-id", "0",
        "--ardupilot-vehicle", "ArduCopter",
        "--ardupilot-frame", "gazebo-px4vision",
        "--ardupilot-model", "JSON",
        "--ardupilot-world", "px4vision_default",
        "--ardupilot-location", "Purdue",
        "--px4-vehicle", "4001",
        "--px4-frame", "gz_px4vision",
        "--px4-world", "default",
        "--px4-location", "Purdue",
        "--n", "3",
        "--edge-m", "25, 25", // "--edge-m-range", "2", "10",
        "--vertex-deg", "random", "--vertex-deg-range", "0", "360",
        "--speed-m-s", "random", "--speed-m-s-range", "1", "20",
        "--alt-m", "random", "--alt-m-range", "2", "20",
        "--takeoff-alt-m", "10",
        "--landing-alt-m", "5"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: PX4+Gazebo launcher",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "${workspaceFolder}/tools/launcher/run_px4_gz_sitl.py",
      "args": [
        "--run-root", "${workspaceFolder}/data/sitl_logs",
        "--startup-delay", "2",
        "--max-run-s", "300",
        "--verbose", "--headless",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
