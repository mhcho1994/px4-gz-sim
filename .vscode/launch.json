{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Scenario Generator",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/scenario/scenario_generator.py",
      "args": [
        "turn3pts",
        "--outdir", "${workspaceFolder}/data/sitl_logs",
        "--runs", "2",
        "--turn-deg", "random",
        "--takeoff-alt-m", "random",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: PX4+Gazebo launcher",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "${workspaceFolder}/tools/launcher/run_px4_gz_sitl.py",
      "args": [
        "--run-root", "${workspaceFolder}/data/sitl_logs",
        "--startup-delay", "2",
        "--max-run-s", "300",
        "--force", "--verbose", "--headless",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: ArduPilot+Gazebo launcher",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "${workspaceFolder}/tools/launcher/run_arducopter_gz_sitl.py",
      "args": [
        "--run-root", "${workspaceFolder}/data/sitl_logs",
        "--startup-delay", "2",
        "--max-run-s", "300",
        "--force", "--verbose", "--headless",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: Pymavlink PX4 Commander",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/commander/pymavlink_px4_commander.py",
      "args": [
        "--scenario", "${workspaceFolder}/data/sitl_logs/run_000/scenario.yaml"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: Pymavlink Ardupilot Commander",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/commander/pymavlink_ardupilot_commander.py",
      "args": [
        "--scenario", "${workspaceFolder}/data/sitl_logs/run_000/scenario.yaml"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: Fake GCS for PX4 SITL Headless",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/commander/fake_gcs_heartbeat.py",
      "args": [
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: SITL Log Converter",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/tools/log_processing/sitl_log_converter.py",
      "args": [
        "--run-dir", "${workspaceFolder}/data/sitl_logs/run_000",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: Flight Log Converter",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/tools/log_processing/flight_log_converter.py",
      "args": [
        "--ardu-logs-dir", "${workspaceFolder}/data/flight_logs/ardu_logs",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: SVM Test",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/ws/drone_classifier_svm/train_dwt_svm.py",
      "args": [
        "--ardu-logs-dir", "${workspaceFolder}/data/flight_logs/ardu_logs",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },

  ]
}